# ---------------------------------------------------------------------------
# Agentic AI Agricultural Crop Planning & Precision Farming System
# Copy to `.env` and fill in what you have.  EVERY value below is optional:
# the system boots, runs every agent and produces reports with no secrets at
# all.  `.env` is gitignored - never commit a filled-in copy.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
APP_NAME="Agentic AI Agricultural Crop Planning & Precision Farming System"
APP_VERSION=1.0.0
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
API_V1_PREFIX=/api/v1
# Comma-separated exact origins.  Add your deployed frontend origin here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Database --------------------------------------------------------------
# Default is a local SQLite file (zero infrastructure).  For PostgreSQL use a
# DSN such as the one below and run `alembic upgrade head` once.
DATABASE_URL=sqlite:///./agri.db
# DATABASE_URL=postgresql+psycopg://agri_user:CHANGE_ME@localhost:5432/agri
SQL_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# --- Weather provider (optional) ------------------------------------------
# Chain used by the weather agent, in order:
#   1. OpenWeatherMap  (needs WEATHER_API_KEY; free tier at openweathermaps.org)
#   2. Open-Meteo      (keyless, live, used automatically when no key is set)
#   3. offline-climatology - a clearly-labelled deterministic estimate used only
#      if every upstream call fails.  It is ALWAYS reported with
#      is_simulated=true and source="offline-climatology"; the system never
#      presents fallback weather as if it came from an API.
WEATHER_API_KEY=
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10
WEATHER_FORECAST_DAYS=7
ALLOW_OFFLINE_WEATHER_FALLBACK=true

# --- LLM provider for advisory narratives (optional) -----------------------
# With no key the advisory agent composes deterministic, evidence-based text.
# All numbers always come from the analysis services, never from the LLM.
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20
LLM_ENABLED=true

# --- Retrieval (agricultural RAG / FAISS) ---------------------------------
RAG_TOP_K=4
RAG_MIN_SCORE=0.05
RAG_RELATIVE_SCORE_RATIO=0.4
RAG_REBUILD_ON_STARTUP=false

# --- Machine learning ------------------------------------------------------
# Leave ML_ARTIFACTS_DIR unset to use the absolute default inside the repo.
# ML_ARTIFACTS_DIR=./app/ml/artifacts
ML_AUTOLOAD=true
ML_RANDOM_SEED=20240517

# --- Behaviour -------------------------------------------------------------
SEED_DEMO_DATA_ON_STARTUP=true    # false in production
# Leave REPORTS_DIR unset to use the absolute default inside the repo.
# REPORTS_DIR=./reports

# --- Frontend (Vite; must be prefixed VITE_ to reach the browser) ---------
VITE_API_BASE_URL=/api/v1
