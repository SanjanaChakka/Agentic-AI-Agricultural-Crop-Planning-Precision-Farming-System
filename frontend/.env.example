# ---------------------------------------------------------------------------
# Agentic AI Agricultural Crop Planning & Precision Farming System - frontend
# ---------------------------------------------------------------------------
# Base URL for every API call made by the app.
#
# In development this is a RELATIVE path: Vite's dev server proxies `/api`
# to the FastAPI backend (see `server.proxy` in vite.config.ts), so the browser
# never talks to the backend host directly and there is no CORS setup.
#
# If you deploy the built assets behind a reverse proxy that already forwards
# `/api` to the backend, keep this value as-is.
VITE_API_BASE_URL=/api/v1

# Optional: override the dev-server proxy target (defaults to http://127.0.0.1:8000)
# VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# NEVER put secrets in this file or in `.env`. Everything prefixed with
# `VITE_` is inlined into the client bundle and is therefore public.
# Only server-side secrets (weather provider keys, LLM keys, database URLs)
# belong in the backend environment - the frontend never needs them.
# ---------------------------------------------------------------------------