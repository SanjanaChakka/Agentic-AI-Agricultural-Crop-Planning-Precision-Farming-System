# syntax=docker/dockerfile:1
#
# Backend image for the Agentic AI Agricultural Crop Planning system.
#
# Build from the repository root:
#   docker build -f Dockerfile.backend -t agri-backend .
#
# The trained models are committed under `backend/app/ml/artifacts`, so the
# default is to reuse them and build only the (cheap) FAISS knowledge index.
# Set --build-arg TRAIN_AT_BUILD=true to retrain from scratch instead.
#
# Build from the repository root:
#   docker build -f Dockerfile.backend -t agri-backend .

# ---------------------------------------------------------------------------
# Stage 1 - build the regenerable artefacts
# ---------------------------------------------------------------------------
FROM python:3.13-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /build

# Dependency layer: cached until requirements change.
COPY backend/requirements.txt backend/requirements-dev.txt ./
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/ ./

# Reuse the committed models by default; the knowledge index is generated here
# because it is derived from the corpus and is not committed. Training is
# deterministic via ML_RANDOM_SEED, so an opt-in retrain is reproducible.
ARG TRAIN_AT_BUILD=false
RUN if [ "$TRAIN_AT_BUILD" = "true" ]; then \
        python -m app.ml.train && python -m app.rag.build; \
    else \
        test -f app/ml/artifacts/soil_moisture_forecast.joblib \
        || { echo "Committed ML artefacts are missing; rebuild with --build-arg TRAIN_AT_BUILD=true" >&2; exit 1; }; \
        python -m app.rag.build; \
    fi

# ---------------------------------------------------------------------------
# Stage 2 - runtime
# ---------------------------------------------------------------------------
FROM python:3.13-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    ENVIRONMENT=production \
    DEBUG=false \
    SEED_DEMO_DATA_ON_STARTUP=false \
    ALLOW_OFFLINE_WEATHER_FALLBACK=true

WORKDIR /app

COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt \
    && apt-get update \
    && apt-get install --no-install-recommends --yes curl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/app /app/app

# Run unprivileged. The app writes only to /data (database + generated reports).
RUN useradd --create-home --uid 10001 agri \
    && mkdir -p /data/reports \
    && chown -R agri:agri /app /data
USER agri

EXPOSE 8000

# Probe the port the app is actually bound to, not a hardcoded 8000: with PORT
# injected (Render, most PaaS) 8000 answers nothing and the container is marked
# unhealthy even though it is serving correctly.
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
    CMD curl -fsS "http://127.0.0.1:${PORT:-8000}/api/v1/health/ready" || exit 1

# Honour $PORT. Render injects PORT (10000 on most plans) and routes traffic to
# the port the service reports; hardcoding 8000 is a common reason a container
# deploys fine locally and 502s on a PaaS. Locally PORT is unset, so this still
# falls back to 8000.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000} --proxy-headers"]