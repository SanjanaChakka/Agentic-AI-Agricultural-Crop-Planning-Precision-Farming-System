# Keep the build context small and never ship secrets or artefacts into an image.

.git/
.gitignore
**/.venv/
**/node_modules/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.coverage
**/htmlcov/

# Secrets - baked into images by accident often enough to be worth blocking.
**/.env
**/.env.local
**/*.pem
**/*.key

# Regenerable at image build time, or not needed inside the image.
# NOTE: the trained .joblib models are deliberately NOT excluded - they are
# committed to git so a fresh clone and a CI build both have working ML without
# retraining. Dockerfile.backend reuses them and only rebuilds the RAG index.
backend/app/ml/artifacts/*.pkl
backend/app/ml/rag_index/
backend/agri.db
backend/reports/
backend/artifacts/

# Local runtime noise.
backend/*.log
backend/server.pid
**/*.tsbuildinfo
frontend/dist/
frontend/coverage/

# Docs and deployment config are not needed inside the images.
README.md
docs/