# ---------------------------------------------------------------------------
# Secrets - never commit these.  `.env.example` holds the placeholders.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key

# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Runtime data (regenerated on first boot)
# ---------------------------------------------------------------------------
backend/agri.db
backend/agri.db-journal
backend/*.log
backend/server.pid
backend/reports/
backend/data/exports/

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/*.tsbuildinfo
frontend/.env
frontend/.env.local

# ---------------------------------------------------------------------------
# ML / RAG artifacts (large, regenerable binaries)
# ---------------------------------------------------------------------------
backend/app/ml/artifacts/*.joblib
backend/app/ml/artifacts/*.pkl
backend/app/ml/rag_index/
backend/app/rag/index/
backend/knowledge_index/

# ---------------------------------------------------------------------------
# Editors / OS
# ---------------------------------------------------------------------------
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
